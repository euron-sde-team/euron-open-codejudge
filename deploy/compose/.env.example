# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SESSION_SECRET=replace-with-output-of-make-env
INVITE_TOKEN_PEPPER=replace-with-output-of-make-env
LOCAL_MASTER_KEY=replace-with-output-of-make-env
JUDGE_TOKEN=replace-with-output-of-make-env
CJ_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional overrides
# CJ_LOG_LEVEL=INFO
# CJ_JUDGES=2                 (judge workers; each judges one submission at a time)
# CJ_APT_MIRROR=              (a faster Debian mirror for building the judge image, e.g.
#                              http://ftp.de.debian.org/debian; must also serve <url>-security)
# CJ_WEB_PORT=4710
# CJ_API_PORT=4730
# CJ_MAILPIT_PORT=4725
# CJ_MOCK_AI_PORT=4750
# CJ_PG_PORT=4742
# CJ_REDIS_PORT=4779
# CJ_FLOCI_PORT=4766
